DATABASE ExampleDatabase
PACKAGE com.example.db
SERVER ExampleServer
SCHEMA ToDoList_App

TABLE DynamicSQL
    Id              INT
    Sent            BYTE
    SendDateTime    TIMESTAMP NULL

KEY PKey PRIMARY Id

PROC BatchMarkAsSent
SQLCODE
    UPDATE DynamicSQL
    SET Sent = 1,
        SendDateTime = CURRENT_TIMESTAMP
    WHERE Id IN ( &SentIds )
ENDCODE

PROC MarkSelected
INPUT
    Sent =
SQLCODE
    UPDATE DynamicSQL
    SET Sent = :Sent
    WHERE Id IN ( &SentIds )
ENDCODE

PROC MarkAll
SQLCODE
    UPDATE DynamicSQL SET Sent = 1
ENDCODE

PROC MarkOne
INPUT
    Id =
SQLCODE
    UPDATE DynamicSQL SET Sent = 1 WHERE Id = :Id
ENDCODE
